# Entorno
NODE_ENV=development

# Servidor
PORT=3001
BACKEND_PUBLIC_URL=http://localhost:3001

# Base de datos (PostgreSQL) - funciona con cualquier proveedor cloud-agnostic
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# JWT
JWT_SECRET="tu-secreto-super-seguro-para-access-token-cambiar-en-produccion"
JWT_REFRESH_SECRET="tu-secreto-super-seguro-para-refresh-token-cambiar-en-produccion"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
# Lista separada por comas. Acepta las siguientes formas:
#   - Origen exacto:                  https://app.ejemplo.com
#   - Wildcard con prefijo (recomendado para Vercel):
#                                     sportmetric-*.vercel.app
#                                     (matchea solo subdominios que EMPIECEN
#                                      por "sportmetric-" y TERMINEN en
#                                      ".vercel.app", p. ej. los previews
#                                      del proyecto)
#   - Wildcard de subdominio (NO recomendado en hosting compartido):
#                                     *.vercel.app
#                                     (matchea CUALQUIER subdominio de
#                                      vercel.app, incluyendo proyectos
#                                      de OTROS usuarios)
#   - Wildcard total (solo para desarrollo local):
#                                     *
# Si una entrada no es valida (por ejemplo, "sportmetric-*vercel.app"
# sin punto antes del TLD), se ignora silenciosamente y se registra un
# warning en consola al arrancar el servidor.
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Proxy inverso
# 0 para desarrollo local sin proxy.
# 1 cuando hay un proxy confiable delante (por ejemplo Render).
TRUST_PROXY_HOPS=0
