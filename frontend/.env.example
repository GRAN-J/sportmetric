# =============================================================================
# Fuente de datos y backend
# =============================================================================
# - local: usa los JSON locales del proyecto (modo offline / desarrollo)
# - api:   consume el backend configurado en VITE_API_BASE_URL
VITE_DATA_SOURCE=local

# URL completa del backend. Si esta vacia, el frontend hara fetch al mismo
# origen (util cuando hay un proxy reverso en el proveedor de hosting).
# En desarrollo local, se suele dejar vacia para usar el proxy de Vite
# (/api/* -> http://127.0.0.1:3001).
# En produccion, establecer la URL publica del backend, por ejemplo:
#   VITE_API_BASE_URL=https://api.mi-dominio.com
VITE_API_BASE_URL=

# =============================================================================
# Content-Security-Policy
# =============================================================================
# El plugin "sportmetric:csp" de vite.config.js genera automaticamente la
# cadena CSP a partir de las variables de entorno. Las variables aqui
# listadas son OPCIONALES y solo se usan si se necesita extender la CSP
# por encima de los valores por defecto.

# Origenes extra permitidos en connect-src (separados por coma).
# Util para servicios externos adicionales (analytics, S3, etc.).
# VITE_CSP_EXTRA_CONNECT_SRC=https://analytics.example.com,https://cdn.example.com

# Origenes extra permitidos en img-src (separados por coma).
# VITE_CSP_EXTRA_IMG_SRC=https://images.example.com

# Origenes extra permitidos en script-src (separados por coma).
# VITE_CSP_EXTRA_SCRIPT_SRC=https://cdn.jsdelivr.net

# Si vale "true", la CSP se aplica en modo report-only (no bloquea, solo
# reporta). Util para validar una nueva politica antes de endurecerla.
# VITE_CSP_REPORT_ONLY=false
